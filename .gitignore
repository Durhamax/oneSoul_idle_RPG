# Logs
*.log
npm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
temp/
*_backup.html

# Debug files
debug_*.js
debug_*.html

# Save game files (optional - uncomment if you don't want to track saves)
# save_*.json
# autosave.json

# Windows device files
nul

# =============================================================================
# DATA WORKFLOW
# =============================================================================

# Excel source files (managed in OneDrive, not in repo)
*.xlsx
*.xls
OneSoul_GameData/

# CSV templates (one-time generation, not tracked)
data/csv/
*.csv

# JSON data files (TRACKED - generated from Excel)
# These are explicitly NOT ignored so they get committed:
!data/json/*.json

# Node modules
node_modules/

# npm package lock (optional - uncomment if you want to ignore)
# package-lock.json
